# Postgres (Railway)
DATABASE_URL=postgresql://user:pass@host:5432/db
# Public URL of this app (used for webhooks + widget embed)
APP_URL=http://localhost:3000
# Auth.js session secret — any long random string
AUTH_SECRET=
# Encrypts tenant credentials at rest — any long random string, never change after use
ENCRYPTION_KEY=
# Platform keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
SARVAM_API_KEY=
# Protects /api/cron/* (send as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
# Vision model used to read images/PDFs customers send on WhatsApp
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
